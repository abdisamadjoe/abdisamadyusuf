# Resume chatbot backend configuration.
# Copy to .env for local use:  cp .env.example .env

# Port the Express server listens on. Railway/Render inject their own PORT.
PORT=3001

# Comma-separated list of browser origins allowed to call POST /api/chat.
# Leave unset in local development to allow every origin.
# In production, set it to your site so no other website can use your endpoint:
#   CORS_ORIGIN=https://abdisamadjoe.com,https://www.abdisamadjoe.com
CORS_ORIGIN=

# Set automatically by most hosts; controls brain hot-reloading.
# NODE_ENV=production
