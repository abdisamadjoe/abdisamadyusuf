> object yearsOfExperience javascript
  // First professional role: IT Support Specialist, Samakaal Hospital, Nov 2021.
  var START_YEAR = 2021;
  var START_MONTH = 11;
  var now = new Date();
  var years = now.getFullYear() - START_YEAR;
  if (now.getMonth() + 1 < START_MONTH) years -= 1;
  return years >= 1 ? String(years) + "+" : "5+";
