NEXT_PUBLIC_APP_URL=https://acme.com

# Set by Vercel on every deployment and read by the footer title block.
# Locally they are unset, so the BUILD field reads "unavailable" — fill them in
# to preview how a deployment renders. VERCEL_ENV: production | preview
VERCEL_ENV=
VERCEL_GIT_COMMIT_SHA=

NEXT_PUBLIC_REGISTRY_NAMESPACE=@acme
NEXT_PUBLIC_REGISTRY_NAMESPACE_URL=https://acme.com/r/{name}.json

# Repo star count. No scopes needed.
# https://github.com/settings/tokens
GITHUB_API_TOKEN=

# GitHub contributions graph on the home page and in the component demos.
# https://github.com/grubersjoe/github-contributions-api
NEXT_PUBLIC_GITHUB_CONTRIBUTIONS_API_URL=https://github-contributions-api.jogruber.de/v4
NEXT_PUBLIC_LOGO_DEV_TOKEN=

# https://www.dmca.com/ProtectionPro.aspx
NEXT_PUBLIC_DMCA_URL=https://www.dmca.com

# YouTube playlist view count on the home page ("When I'm Not Building").
# Server-side only, read by functions/api/youtube-views.ts (a Cloudflare
# Pages Function) — never exposed to the client. For local dev with
# `wrangler pages dev`, put this in `.dev.vars` instead (gitignored); in
# production, set it as an encrypted environment variable on the Cloudflare
# Pages project.
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# https://dashboard.openpanel.dev/abdisamadjoe/chanhdaicom/settings/clients
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
OPENPANEL_PROJECT_ID=
OPENPANEL_CLIENT_ID=
OPENPANEL_CLIENT_SECRET=

ADS_TXT=
NEXT_PUBLIC_ADSENSE_CLIENT=

# Cloudflare R2 (used by `npm run capture:sync` to publish screenshots)
# https://dash.cloudflare.com/?to=/:account/r2/api-tokens
# S3 API endpoint, e.g. https://<account>.r2.cloudflarestorage.com
R2_S3_API=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Resume chatbot backend (see chatbot-server/). The floating "Ask Abdisamad"
# widget in src/components/ResumeChatbot posts to ${VITE_CHATBOT_API_URL}/api/chat.
# Local development: run `cd chatbot-server && npm run dev` on port 3001.
# Production: point this at your deployed backend, e.g.
#   VITE_CHATBOT_API_URL=https://chat.abdisamadjoe.com
# If unset, the client falls back to http://localhost:3001.
VITE_CHATBOT_API_URL=
