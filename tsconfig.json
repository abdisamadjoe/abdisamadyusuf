{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "next/cache": ["./src/lib/cache.ts"],
      "next/dynamic": ["./src/lib/shims/dynamic.tsx"],
      "next/image": ["./src/lib/shims/image.tsx"],
      "next/link": ["./src/lib/shims/link.tsx"],
      "next/navigation": ["./src/lib/shims/navigation.tsx"],
      "@bprogress/next/app": ["./src/lib/shims/bprogress.tsx"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "./src/scripts/build-registry.mts"
  ],
  "exclude": [
    "node_modules"
  ]
}