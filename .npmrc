# npm is stricter than pnpm about peer dependencies. This project (like many
# React Router + fumadocs setups) has optional peers that intentionally don't
# match the installed versions (e.g. fumadocs-core's optional zod@4 peer vs the
# project's zod@3). pnpm tolerated those; npm needs legacy-peer-deps to do the
# same. See https://docs.npmjs.com/cli/v10/using-npm/config#legacy-peer-deps
legacy-peer-deps=true
